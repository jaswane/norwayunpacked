# Indexability gate — single source of truth for search-engine visibility.
# The site is NON-indexable unless this is explicitly "true".
# Leave unset (or "false") during build and staging.
# Open for indexing at launch by setting this to "true" in the production
# environment and redeploying. See src/lib/site.ts.
SITE_INDEXABLE=false

# Analytics is not configured yet. No GA4 Measurement ID exists for this
# project — do not invent one. When GA4 is set up later it must be
# consent-gated (no Google calls before consent).
